{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_call.schema.json",
  "title": "AssetCall",
  "description": "资产调用清单（EP001_assets.csv 每行）。字段与 make-spec.md 3.1~3.3 一一对应。",
  "type": "object",
  "required": ["asset_id", "type", "name", "appearance_count", "closeup_count", "total_duration_sec", "shot_ids", "need_design", "design_file"],
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^(CHAR-\\d{3}|SC-\\d{2}|PR-\\d{2}|V-\\d{2})$",
      "description": "唯一资产编号"
    },
    "type": {
      "type": "string",
      "enum": ["char", "scene", "prop", "voice"],
      "description": "资产类型"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "剧本原文名字，不改字"
    },
    "appearance_count": {
      "type": "integer",
      "minimum": 0,
      "description": "出场镜头数（make-spec 3.1「出场镜头数」）"
    },
    "closeup_count": {
      "type": "integer",
      "minimum": 0,
      "description": "特写次数（make-spec「特写频率」依据）"
    },
    "total_duration_sec": {
      "type": "number",
      "minimum": 0,
      "description": "出场累计时长（make-spec 3.1「出场累计时长」）"
    },
    "shot_ids": {
      "type": "string",
      "description": "出场镜头号，逗号分隔（make-spec「出场场次/镜头号」）"
    },
    "need_design": {
      "type": "string",
      "enum": ["需要", "不需要"],
      "description": "是否需要定妆图/设定图（make-spec「是否需要定妆图」）"
    },
    "design_file": {
      "type": "string",
      "description": "设定图文件名（make-spec「定妆图文件名」）"
    },
    "remark": {
      "type": "string",
      "description": "备注（身份定位 / 场景资产要求 / 关键剧情道具 等）"
    }
  }
}
